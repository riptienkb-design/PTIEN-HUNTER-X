{
  "name": "@ptien/database",
  "version": "0.1.0",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "type-check": "tsc --noEmit",
    "migrate": "node --loader ts-node/esm ./src/migrate.ts",
    "seed": "node --loader ts-node/esm ./src/seed.ts",
    "reset": "node --loader ts-node/esm ./src/reset.ts",
    "test": "vitest"
  },
  "dependencies": {
    "drizzle-orm": "^0.29.1",
    "pg": "^8.11.3",
    "zod": "^3.22.4"
  },
  "devDependencies": {
    "@types/node": "^20.10.6",
    "@types/pg": "^8.10.9",
    "typescript": "^5.2.2",
    "vitest": "^0.34.6"
  }
}
